#!/bin/sh
# dpkg runs this as root; reminder state and notifications belong to each user.
# The global XDG bootstrap handles users without a current desktop session.
set -eu
case "${1:-}" in --reminder-setup|--reminder-remove) ;; *) exit 2 ;; esac
for runtime in /run/user/[0-9]*; do
    [ -d "$runtime" ] || continue
    uid=${runtime##*/}
    [ "$uid" != 0 ] || continue
    [ -S "$runtime/bus" ] || continue
    record=$(getent passwd "$uid") || continue
    username=$(printf '%s\n' "$record" | cut -d: -f1)
    user_home=$(printf '%s\n' "$record" | cut -d: -f6)
    if ! runuser -u "$username" -- env HOME="$user_home" XDG_DATA_HOME="$user_home/.local/share" \
        XDG_CONFIG_HOME="$user_home/.config" XDG_RUNTIME_DIR="$runtime" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" /usr/bin/markerup "$1"; then
        echo "Markerup: reminder service update for $username failed; opening Markerup or logging in will retry." >&2
    fi
done
