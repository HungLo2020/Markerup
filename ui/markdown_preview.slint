import { CheckBox, HorizontalBox, ScrollView } from "std-widgets.slint";

// One value contains every render-time attribute for one Markdown block. Keeping
// these values together prevents a model update from pairing a block with the
// wrong task, image, or Mermaid result.
export struct PreviewBlockData {
    text: styled-text,
    plain-text: string,
    kind: int,
    heading-level: int,
    task-checked: bool,
    task-offset: int,
    mermaid-image: image,
    mermaid-error: string,
    image: image,
}

// Shared Markdown block renderer used by both desktop and mobile shells.
// The shells provide navigation and decide how much space this component gets;
// this component owns the visual treatment of Markdown itself.
export component MarkdownPreview inherits Rectangle {
    in property <[PreviewBlockData]> blocks;
    in property <string> document-title: "";
    in property <bool> show-document-title: false;
    in property <bool> mouse-drag-pan-enabled: false;
    in property <length> block-spacing: 12px;

    callback link-clicked(string);
    callback task-toggled(int);

    ScrollView {
        width: parent.width;
        height: parent.height;
        mouse-drag-pan-enabled: root.mouse-drag-pan-enabled;

        VerticalLayout {
            alignment: start;
            spacing: root.block-spacing;
            padding: 8px;

            if root.show-document-title : Text {
                text: root.document-title;
                width: 100%;
                color: #f2f2f7;
                font-size: 22px;
                font-weight: 700;
                wrap: word-wrap;
            }

            for block[index] in root.blocks : VerticalLayout {
                alignment: start;
                vertical-stretch: 0;
                width: 100%;
                padding: 0px;
                spacing: 0px;

                if block.kind == 1 : Text {
                    width: 100%;
                    text: block.plain-text;
                    wrap: word-wrap;
                    color: #f2f2f7;
                    font-weight: 700;
                    font-size: block.heading-level == 1 ? 30px
                        : block.heading-level == 2 ? 26px
                        : block.heading-level == 3 ? 22px
                        : block.heading-level == 4 ? 19px
                        : block.heading-level == 5 ? 17px
                        : 15px;
                }

                if block.kind == 2 : HorizontalBox {
                    width: 100%;
                    spacing: 10px;
                    CheckBox {
                        width: 24px;
                        checked: block.task-checked;
                        toggled => { root.task-toggled(block.task-offset); }
                    }
                    StyledText {
                        horizontal-stretch: 1;
                        text: block.text;
                        height: self.preferred-height;
                        vertical-alignment: top;
                        default-color: #f2f2f7;
                        default-font-size: 16px;
                        link-color: #72b7ff;
                        link-clicked(link) => { root.link-clicked(link); }
                    }
                }

                if block.kind == 3 : VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    width: 100%;
                    padding: 0px;
                    spacing: 0px;
                    if block.mermaid-error != "" : Text {
                        width: 100%;
                        text: block.mermaid-error;
                        color: #ff8b8b;
                        wrap: word-wrap;
                    }
                    if block.mermaid-error == "" : Image {
                        width: 100%;
                        height: min(420px, max(100px, self.preferred-height));
                        image-fit: contain;
                        source: block.mermaid-image;
                    }
                }

                if block.kind == 0 || block.kind == 5 || block.kind == 9 || block.kind == 10 : StyledText {
                    width: 100%;
                    text: block.text;
                    height: self.preferred-height;
                    vertical-alignment: top;
                    default-color: #f2f2f7;
                    default-font-size: 16px;
                    link-color: #72b7ff;
                    link-clicked(link) => { root.link-clicked(link); }
                }

                if block.kind == 4 : Rectangle {
                    width: 100%;
                    background: #252b35;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 0px;
                        Text {
                            width: 100%;
                            text: block.plain-text;
                            wrap: word-wrap;
                            color: #e5e7eb;
                            font-family: "monospace";
                            font-size: 14px;
                        }
                    }
                }

                if block.kind == 6 : Rectangle {
                    width: 100%;
                    background: #242832;
                    border-color: #64748b;
                    border-width: 3px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 0px;
                        StyledText {
                            width: 100%;
                            text: block.text;
                            height: self.preferred-height;
                            vertical-alignment: top;
                            default-color: #d1d5db;
                            default-font-size: 16px;
                        }
                    }
                }

                if block.kind == 7 : Rectangle {
                    width: 100%;
                    height: 1px;
                    background: #4b5563;
                }

                if block.kind == 8 : VerticalLayout {
                    alignment: start;
                    vertical-stretch: 0;
                    width: 100%;
                    padding: 0px;
                    spacing: 0px;
                    Image {
                        width: 100%;
                        height: min(360px, max(80px, self.preferred-height));
                        image-fit: contain;
                        source: block.image;
                    }
                    Text {
                        width: 100%;
                        text: block.plain-text;
                        color: #9ca3af;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
