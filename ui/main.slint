import { Button, CheckBox, HorizontalBox, LineEdit, ListView, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";
import { MobileWindow } from "mobile.slint";
import { MarkdownPreview } from "markdown_preview.slint";
export { MobileWindow } from "mobile.slint";

component DesktopTreeRow inherits Rectangle {
    in property <string> text;
    in property <int> entry-kind;
    in property <int> depth;
    callback clicked;
    height: 28px;
    horizontal-stretch: 1;
    background: #2c2c2e;
    TouchArea { clicked => { root.clicked(); } }
    Image {
        visible: root.entry-kind > 0;
        source: @image-url("../resources/icon_folder.svg");
        x: root.depth * 18px + 6px;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        image-fit: contain;
    }
    Text {
        x: root.depth * 18px + (root.entry-kind > 0 ? 32px : 8px);
        width: parent.width - self.x - 8px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }
}

component DesktopIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked;
    width: 36px;
    height: 36px;
    background: #3a3a3c;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: root.label;
    TouchArea { clicked => { root.clicked(); } }
    Image {
        source: root.icon;
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
}

export component DesktopWindow inherits Window {
    title: root.dirty ? "Markerup *" : "Markerup";
    preferred-width: 1360px;
    preferred-height: 820px;
    min-width: 840px;
    min-height: 520px;
    forward-focus: keyboard;

    in-out property <[string]> tree-labels;
    in-out property <[int]> tree-entry-kinds;
    in-out property <[int]> tree-entry-depths;
    in-out property <[string]> search-results;
    in-out property <[styled-text]> preview-block-texts;
    in-out property <[string]> preview-block-plain-texts;
    in-out property <[int]> preview-block-kinds;
    in-out property <[int]> preview-heading-levels;
    in-out property <[bool]> preview-task-checked;
    in-out property <[int]> preview-task-offsets;
    in-out property <[image]> preview-block-mermaid-images;
    in-out property <[string]> preview-block-mermaid-errors;
    in-out property <[image]> preview-block-images;
    in-out property <[image]> preview-images;
    in-out property <[string]> preview-image-labels;
    in-out property <string> workspace-path: "";
    in-out property <string> selected-path: "";
    in-out property <string> current-path: "No note selected";
    in-out property <string> app-version: "";
    in-out property <string> app-build-number: "development";
    in-out property <string> editor-text: "";
    in-out property <length> editor-content-height: 480px;
    in-out property <string> status: "Choose a folder to use as a Markerup workspace";
    in-out property <string> action-name: "";
    in-out property <string> search-query: "";
    in-out property <string> find-query: "";
    in-out property <string> find-status: "";
    in-out property <string> diagnostic-report: "No diagnostic report available.";
    in-out property <string> smb-server: "";
    in-out property <string> smb-share: "";
    in-out property <string> smb-username: "";
    in-out property <string> smb-password: "";
    in-out property <string> smb-remote-path: "";
    in-out property <bool> workspace-open: false;
    in-out property <bool> workspace-is-smb: false;
    in-out property <bool> workspace-pinned: false;
    in-out property <bool> dirty: false;
    in-out property <bool> external-conflict: false;
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <bool> sidebar-visible: true;
    in-out property <int> view-mode: 1;

    callback choose-workspace-requested();
    callback pin-workspace-requested();
    callback tree-selected(int);
    callback overwrite-requested(string);
    callback reload-requested();
    callback editor-changed(string);
    callback preview-link-clicked(string);
    callback preview-task-toggled(int);
    callback refresh-requested();
    callback new-note-requested(string);
    callback new-folder-requested(string);
    callback rename-requested(string);
    callback delete-requested();
    callback search-requested(string);
    callback search-result-selected(int);
    callback find-next-requested(string);
    callback back-requested();
    callback privacy-policy-requested();
    callback forward-requested();
    callback select-editor-range(int, int);
    callback diagnostic-requested();
    callback copy-diagnostic-requested();
    callback connect-smb-requested();
    callback smb-keyboard-dismiss-requested();
    callback smb-connect-submitted(string, string, string, string, string);
    callback smb-connect-cancelled();

    select-editor-range(start, end) => {
        editor.set-selection-offsets(start, end);
        editor.focus();
    }

    keyboard := FocusScope {
        width: parent.width;
        height: parent.height;

        KeyBinding {
            keys: @keys(Control + F);
            activated => { root.find-next-requested(root.find-query); }
        }

        VerticalBox {
            width: parent.width;
            height: parent.height;
            padding: 10px;
            spacing: 7px;

            HorizontalBox {
                height: 36px;
                spacing: 6px;
                if root.view-mode < 5 : DesktopIconButton {
                    icon: @image-url("../resources/icon_menu.svg");
                    label: "Toggle workspace sidebar";
                    clicked => { root.sidebar-visible = !root.sidebar-visible; }
                }
                Text {
                    text: root.workspace-open ? "Markerup  •  " + root.workspace-path : "Markerup  •  No workspace selected";
                    vertical-alignment: center;
                    overflow: elide;
                }
                Button { text: "←"; enabled: root.workspace-open && root.can-go-back; clicked => { root.back-requested(); } }
                Button { text: "→"; enabled: root.workspace-open && root.can-go-forward; clicked => { root.forward-requested(); } }
                Button { text: "Refresh"; enabled: root.workspace-open; clicked => { root.refresh-requested(); } }
                Button { text: "Reload"; enabled: root.workspace-open && root.current-path != "No note selected"; clicked => { root.reload-requested(); } }
                Rectangle { horizontal-stretch: 1; }
                DesktopIconButton {
                    icon: @image-url("../resources/icon_preview_settings.svg");
                    label: "Settings";
                    clicked => { root.view-mode = 6; }
                }
            }

            conflict-banner := Rectangle {
                visible: root.external-conflict;
                height: root.external-conflict ? 42px : 0px;
                background: #7d2b2b;
                HorizontalBox {
                    padding: 6px;
                    spacing: 8px;
                    Text { text: "External change conflict — choose which version wins."; color: white; vertical-alignment: center; }
                    Button { text: "Use Disk"; clicked => { root.reload-requested(); } }
                    Button { text: "Overwrite Disk"; clicked => { root.overwrite-requested(root.editor-text); } }
                }
            }

            Rectangle { height: 1px; background: #80808040; }

            content := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;

            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                visible: root.view-mode == 6;
                VerticalBox {
                    width: parent.width; height: parent.height;
                    spacing: 12px;
                    HorizontalBox {
                        height: 40px;
                        Button { text: "Back"; width: 80px; horizontal-stretch: 0; clicked => { root.view-mode = 1; } }
                        Text { text: "Settings"; horizontal-stretch: 1; font-size: 28px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle { width: 80px; }
                    }
                    HorizontalBox {
                        alignment: center;
                        VerticalBox {
                            width: 220px;
                            horizontal-stretch: 0;
                            spacing: 12px;
                            Text { text: "Manage Markerup"; color: #9ca3af; horizontal-alignment: center; }
                            Button { text: "Location"; width: 220px; horizontal-stretch: 0; clicked => { root.view-mode = 7; } }
                            Button { text: "About"; width: 220px; horizontal-stretch: 0; clicked => { root.view-mode = 8; } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                visible: root.view-mode == 7;
                VerticalBox {
                    width: parent.width; height: parent.height;
                    spacing: 12px;
                    HorizontalBox {
                        height: 38px;
                        Button { text: "Back"; width: 80px; horizontal-stretch: 0; clicked => { root.view-mode = 6; } }
                        Text { text: "Location"; horizontal-stretch: 1; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle { width: 80px; }
                    }
                    Text { text: "Current Workspace"; font-weight: 700; }
                    Text { text: root.workspace-open ? (root.workspace-is-smb ? "SMB" : "Local Files") : "None selected"; font-size: 20px; }
                    Text { text: root.workspace-open ? root.workspace-path : "Choose a location to open your notes"; color: #9ca3af; overflow: elide; }
                    HorizontalBox {
                        height: 36px;
                        spacing: 8px;
                        Button { text: "Browse"; width: 140px; horizontal-stretch: 0; clicked => { root.choose-workspace-requested(); } }
                        Button { text: "SMB"; width: 140px; horizontal-stretch: 0; clicked => { root.connect-smb-requested(); } }
                    }
                    Button { text: root.workspace-pinned ? "Unpin Workspace" : "Pin Workspace"; width: 220px; horizontal-stretch: 0; enabled: root.workspace-open; clicked => { root.pin-workspace-requested(); } }
                    Text { text: root.workspace-pinned ? "This workspace will reopen when Markerup starts." : "This workspace is not pinned."; color: #9ca3af; }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                visible: root.view-mode == 8;
                VerticalBox {
                    width: parent.width; height: parent.height;
                    spacing: 12px;
                    HorizontalBox {
                        height: 40px;
                        Button { text: "Back"; width: 80px; horizontal-stretch: 0; clicked => { root.view-mode = 6; } }
                        Text { text: "About"; horizontal-stretch: 1; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle { width: 80px; }
                    }
                    Text { text: "Markerup"; font-size: 28px; font-weight: 700; }
                    Text { text: "Version " + root.app-version + " (build " + root.app-build-number + ")"; color: #9ca3af; }
                    Button { text: "Privacy Policy"; width: 220px; horizontal-stretch: 0; clicked => { root.privacy-policy-requested(); } }
                    Text { text: "https://hunglo2020.github.io/Markerup/privacy-policy/"; color: #6b7280; }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                visible: root.view-mode == 5;
                HorizontalBox {
                    width: parent.width; height: parent.height;
                    alignment: center;
                    VerticalBox {
                        width: 560px;
                        horizontal-stretch: 0;
                        spacing: 8px;
                        HorizontalBox {
                            height: 38px;
                            Button { text: "Back"; width: 80px; horizontal-stretch: 0; clicked => { root.smb-connect-cancelled(); } }
                            Text { text: "Connect to SMB"; horizontal-stretch: 1; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            Rectangle { width: 80px; }
                        }
                        Text { text: "Connect directly to an SMB2/3 server. Credentials are used for this session and are never written to workspace files."; wrap: word-wrap; }
                        Button { text: "Done / Hide Keyboard"; clicked => { root.smb-keyboard-dismiss-requested(); } }
                        LineEdit { text <=> root.smb-server; placeholder-text: "Server or IP address"; }
                        LineEdit { text <=> root.smb-share; placeholder-text: "Share name"; }
                        LineEdit { text <=> root.smb-username; placeholder-text: "Username (blank for guest)"; }
                        LineEdit { text <=> root.smb-password; placeholder-text: "Password"; input-type: password; }
                        LineEdit { text <=> root.smb-remote-path; placeholder-text: "Folder inside share (optional)"; }
                        HorizontalBox {
                            Button { text: "Connect"; width: 180px; horizontal-stretch: 0; primary: true; clicked => { root.smb-connect-submitted(root.smb-server, root.smb-share, root.smb-username, root.smb-password, root.smb-remote-path); } }
                            Button { text: "Cancel"; width: 180px; horizontal-stretch: 0; clicked => { root.smb-connect-cancelled(); } }
                        }
                    }
                }
            }

            central-area := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                empty-pane := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: !root.workspace-open && root.view-mode < 5;

                    HorizontalBox {
                        Rectangle { horizontal-stretch: 1; }
                        VerticalBox {
                            width: 460px;
                            Rectangle { vertical-stretch: 1; }
                            Text {
                                text: "No workspace selected";
                                font-size: 28px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Markerup edits ordinary Markdown files in a folder you choose. Nothing is imported or copied into a database.";
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                            Button {
                                text: "Choose Folder";
                                primary: true;
                                clicked => { root.choose-workspace-requested(); }
                            }
                            Text {
                                text: "After opening a folder, pin it if you want Markerup to reopen it automatically next time.";
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                workspace-pane := HorizontalBox {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.workspace-open && root.view-mode < 5;
                    spacing: 8px;

                    VerticalBox {
                        width: root.sidebar-visible ? 300px : 0px;
                        horizontal-stretch: 0;
                        vertical-stretch: 1;
                        visible: root.sidebar-visible;
                        spacing: 5px;
                        Text { text: "Workspace"; font-weight: 700; }
                        Text { text: root.selected-path == "" ? "Nothing selected" : root.selected-path; overflow: elide; }

                        HorizontalBox {
                            spacing: 4px;
                            LineEdit { text <=> root.action-name; }
                            Button { text: "+ Note"; clicked => { root.new-note-requested(root.action-name); } }
                            Button { text: "+ Folder"; clicked => { root.new-folder-requested(root.action-name); } }
                        }
                        HorizontalBox {
                            spacing: 4px;
                            Button { text: "Rename"; enabled: root.selected-path != ""; clicked => { root.rename-requested(root.action-name); } }
                            Button { text: "Delete"; enabled: root.selected-path != ""; clicked => { root.delete-requested(); } }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for label[index] in root.tree-labels : DesktopTreeRow {
                                text: label;
                                entry-kind: root.tree-entry-kinds[index];
                                depth: root.tree-entry-depths[index];
                                clicked => { root.tree-selected(index); }
                            }
                        }

                        Rectangle { height: 1px; background: #80808040; }
                        Text { text: "Search all notes"; font-weight: 700; }
                        LineEdit {
                            text <=> root.search-query;
                            edited => { root.search-requested(self.text); }
                        }
                        if root.search-results.length > 0 : ListView {
                            height: 150px;
                            for result[index] in root.search-results : Button {
                                text: result;
                                clicked => { root.search-result-selected(index); }
                            }
                        }
                    }

                    Rectangle {
                        width: root.sidebar-visible ? 1px : 0px;
                        background: #80808040;
                    }

                    VerticalBox {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        spacing: 5px;
                        HorizontalBox {
                            Text { text: (root.dirty ? "● " : "") + root.current-path; font-weight: 700; overflow: elide; }
                            Button { text: "Source"; clicked => { root.view-mode = 0; } }
                            Button { text: "Split"; clicked => { root.view-mode = 1; } }
                            Button { text: "Preview"; clicked => { root.view-mode = 2; } }
                        }

                        HorizontalBox {
                            height: 34px;
                            spacing: 5px;
                            Text { text: "Find:"; vertical-alignment: center; }
                            LineEdit { text <=> root.find-query; }
                            Button { text: "Next"; enabled: root.current-path != "No note selected"; clicked => { root.find-next-requested(root.find-query); } }
                            Text { text: root.find-status; vertical-alignment: center; }
                        }

                        editor-preview-row := HorizontalBox {
                            height: max(120px, root.height - 160px);
                            spacing: 7px;

                            source-pane := VerticalBox {
                                visible: root.view-mode != 2;
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                height: parent.height;
                                Text { text: "Markdown source"; font-weight: 600; }
                                editor := TextEdit {
                                    height: max(60px, source-pane.height - 24px);
                                    text <=> root.editor-text;
                                    wrap: word-wrap;
                                    font-family: "monospace";
                                    edited => { root.editor-changed(self.text); }
                                }
                            }

                            preview-pane := VerticalBox {
                                visible: root.view-mode != 0;
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                height: parent.height;
                                Text { text: "Preview"; font-weight: 600; }
                                MarkdownPreview {
                                    vertical-stretch: 1;
                                    height: max(60px, preview-pane.height - 24px);
                                    block-texts: root.preview-block-texts;
                                    block-plain-texts: root.preview-block-plain-texts;
                                    block-kinds: root.preview-block-kinds;
                                    heading-levels: root.preview-heading-levels;
                                    task-checked: root.preview-task-checked;
                                    task-offsets: root.preview-task-offsets;
                                    mermaid-images: root.preview-block-mermaid-images;
                                    mermaid-errors: root.preview-block-mermaid-errors;
                                    images: root.preview-block-images;
                                    link-clicked(link) => { root.preview-link-clicked(link); }
                                    task-toggled(offset) => { root.preview-task-toggled(offset); }
                                }
                            }
                        }
                    }
                }
            }
            }

            Rectangle { height: 1px; background: #80808040; }
            Text {
                height: 24px;
                text: root.status;
                color: root.external-conflict ? #ff7070 : root.dirty ? #d89b36 : #808080;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
