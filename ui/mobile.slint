import { CheckBox, LineEdit, ListView, ScrollView, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { MarkdownPreview } from "markdown_preview.slint";

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 42px;
    min-width: 42px;
    horizontal-stretch: 1;
    background: root.enabled ? #3a3a3c : #29292b;
    border-radius: 9px;
    opacity: root.enabled ? 1 : 0.55;
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Text {
        width: parent.width - 12px;
        x: 6px;
        height: parent.height;
        text: root.text;
        color: #f2f2f7;
        font-size: 16px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    width: 42px;
    height: 42px;
    background: root.enabled ? #3a3a3c : #29292b;
    border-radius: 9px;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        accessible-role: none;
    }
}

component TreeRow inherits Rectangle {
    in property <string> text;
    in property <int> entry-kind;
    in property <int> depth;
    callback activated;
    callback actions-requested;
    height: 42px;
    horizontal-stretch: 1;
    background: #2c2c2e;
    TouchArea { clicked => { root.activated(); } }
    Image {
        visible: root.entry-kind > 0;
        source: @image-url("../resources/icon_folder.svg");
        x: root.depth * 18px + 8px;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        image-fit: contain;
    }
    Text {
        x: root.depth * 18px + (root.entry-kind > 0 ? 38px : 12px);
        width: parent.width - self.x - 54px; height: parent.height;
        text: root.text; font-size: 17px; color: #f2f2f7;
        vertical-alignment: center; horizontal-alignment: left; overflow: elide;
    }
    Rectangle {
        x: parent.width - 46px;
        y: 4px;
        width: 42px;
        height: parent.height - 8px;
        background: #3a3a3c;
        border-radius: 7px;
        TouchArea { clicked => { root.actions-requested(); } }
        Text { text: "…"; width: parent.width; height: parent.height; color: #f2f2f7; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component MobileWindow inherits Window {
    title: root.dirty ? "Markerup *" : "Markerup";
    preferred-width: 390px; preferred-height: 844px; min-width: 320px; min-height: 480px;
    background: #1c1c1e;

    in-out property <[string]> tree-labels;
    in-out property <[int]> tree-entry-kinds;
    in-out property <[int]> tree-entry-depths;
    in-out property <[string]> search-results;
    in-out property <[styled-text]> preview-block-texts;
    in-out property <[string]> preview-block-plain-texts;
    in-out property <[int]> preview-block-kinds;
    in-out property <[int]> preview-heading-levels;
    in-out property <[bool]> preview-task-checked;
    in-out property <[int]> preview-task-offsets;
    in-out property <[image]> preview-block-mermaid-images;
    in-out property <[string]> preview-block-mermaid-errors;
    in-out property <[image]> preview-block-images;
    in-out property <[image]> preview-images;
    in-out property <[string]> preview-image-labels;
    in-out property <string> workspace-path: "";
    in-out property <string> selected-path: "";
    in-out property <string> current-path: "No note selected";
    in-out property <string> app-version: "";
    in-out property <string> app-build-number: "development";
    in-out property <string> editor-text: "";
    in-out property <length> editor-content-height: 480px;
    in-out property <string> status: "Choose a folder to use as a Markerup workspace";
    in-out property <string> action-name: "";
    in-out property <string> search-query: "";
    in-out property <string> find-query: "";
    in-out property <string> find-status: "";
    in-out property <string> diagnostic-report: "No diagnostic report available.";
    in-out property <string> smb-server: "";
    in-out property <string> smb-share: "";
    in-out property <string> smb-username: "";
    in-out property <string> smb-password: "";
    in-out property <string> smb-remote-path: "";
    in-out property <bool> workspace-open: false;
    in-out property <bool> workspace-is-smb: false;
    in-out property <bool> workspace-pinned: false;
    in-out property <bool> dirty: false;
    in-out property <bool> external-conflict: false;
    in-out property <bool> can-go-back: false;
    in-out property <bool> can-go-forward: false;
    in-out property <int> view-mode: 0;
    in-out property <bool> action-menu-visible: false;
    in-out property <bool> action-menu-root: false;
    in-out property <bool> action-menu-folder: false;

    callback choose-workspace-requested(); callback pin-workspace-requested(); callback tree-selected(int);
    callback tree-action-requested(int);
    callback overwrite-requested(string); callback reload-requested();
    callback editor-changed(string); callback preview-link-clicked(string); callback preview-task-toggled(int); callback refresh-requested();
    callback new-note-requested(string); callback new-folder-requested(string); callback new-note-root-requested(string); callback new-folder-root-requested(string); callback rename-requested(string);
    callback delete-requested(); callback search-requested(string); callback search-result-selected(int);
    callback find-next-requested(string); callback back-requested(); callback forward-requested();
    callback select-editor-range(int, int); callback diagnostic-requested(); callback copy-diagnostic-requested();
    callback connect-smb-requested(); callback smb-keyboard-dismiss-requested(); callback privacy-policy-requested();
    callback smb-connect-submitted(string, string, string, string, string); callback smb-connect-cancelled();

    VerticalBox {
        // Keep the shell inside the iPhone safe areas.
        padding: 16px; padding-top: 52px; padding-bottom: 30px; spacing: 0px;

        if root.view-mode == 6 : VerticalBox {
            vertical-stretch: 1; spacing: 12px;
            HorizontalBox {
                height: 44px; alignment: center;
                Text { text: "Settings"; horizontal-stretch: 1; font-size: 30px; font-weight: 700; color: #f2f2f7; vertical-alignment: center; }
            }
            Text { text: "Manage Markerup"; color: #6c6c70; }
            Button { text: "Location"; clicked => { root.view-mode = 7; } }
            Button { text: "SMB Diagnostics"; clicked => { root.diagnostic-requested(); } }
            Button { text: "About"; clicked => { root.view-mode = 8; } }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        if root.view-mode == 8 : VerticalBox {
            vertical-stretch: 1; spacing: 12px;
            HorizontalBox {
                height: 44px; alignment: center;
                Button { text: "Back"; width: 72px; height: 36px; horizontal-stretch: 0; clicked => { root.view-mode = 6; } }
                Text { text: "About"; horizontal-stretch: 1; font-size: 24px; font-weight: 700; color: #f2f2f7; vertical-alignment: center; horizontal-alignment: center; }
                Rectangle { width: 72px; height: 36px; background: transparent; }
            }
            Text { text: "Markerup"; font-size: 28px; font-weight: 700; color: #f2f2f7; }
            Text { text: "Version " + root.app-version + " (build " + root.app-build-number + ")"; color: #aeaeb2; }
            Button { text: "Privacy Policy"; clicked => { root.privacy-policy-requested(); } }
            Text { text: "https://hunglo2020.github.io/Markerup/privacy-policy/"; color: #6c6c70; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        if root.view-mode == 7 : VerticalBox {
            vertical-stretch: 1; spacing: 12px;
            HorizontalBox {
                height: 42px;
                Button { text: "Back"; clicked => { root.view-mode = 6; } }
                Text { text: "Location"; horizontal-stretch: 1; font-size: 24px; font-weight: 700; color: #f2f2f7; vertical-alignment: center; horizontal-alignment: center; }
                Rectangle { width: 42px; height: 42px; background: transparent; }
            }
            Text { text: "Current Workspace"; font-weight: 700; color: #f2f2f7; }
            Text { text: root.workspace-open ? (root.workspace-is-smb ? "SMB" : "Local Files") : "None selected"; font-size: 20px; color: #f2f2f7; }
            Text { text: root.workspace-open ? root.workspace-path : "Choose a location to open your notes"; color: #6c6c70; overflow: elide; }
            HorizontalBox {
                height: 42px; spacing: 8px;
                Button { text: "Browse"; clicked => { root.choose-workspace-requested(); } }
                Button { text: "SMB"; clicked => { root.connect-smb-requested(); } }
            }
            Button { text: root.workspace-pinned ? "Unpin Workspace" : "Pin Workspace"; enabled: root.workspace-open; clicked => { root.pin-workspace-requested(); } }
            Text { text: root.workspace-pinned ? "This workspace will reopen when Markerup starts." : "This workspace is not pinned."; color: #6c6c70; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        if root.view-mode == 5 : VerticalBox {
            vertical-stretch: 1; spacing: 10px;
            HorizontalBox {
                height: 42px;
                Button { text: "Cancel"; clicked => { root.smb-connect-cancelled(); } }
                Text { text: "Connect to SMB"; horizontal-stretch: 1; font-size: 20px; font-weight: 700; color: #f2f2f7; vertical-alignment: center; horizontal-alignment: center; }
                Button { text: "Done"; clicked => { root.smb-keyboard-dismiss-requested(); } }
            }
            Text { text: "Connect directly to an SMB2/3 server."; color: #6c6c70; }
            ScrollView {
                vertical-stretch: 1; mouse-drag-pan-enabled: true;
                VerticalBox {
                    spacing: 10px;
                    Text { text: "Server"; font-weight: 700; color: #f2f2f7; }
                    LineEdit { text <=> root.smb-server; placeholder-text: "Server or IP address"; }
                    Text { text: "Share"; font-weight: 700; color: #f2f2f7; }
                    LineEdit { text <=> root.smb-share; placeholder-text: "Share name"; }
                    Text { text: "Credentials"; font-weight: 700; color: #f2f2f7; }
                    LineEdit { text <=> root.smb-username; placeholder-text: "Username (blank for guest)"; }
                    LineEdit { text <=> root.smb-password; placeholder-text: "Password"; input-type: password; }
                    Text { text: "Folder (optional)"; font-weight: 700; color: #f2f2f7; }
                    LineEdit { text <=> root.smb-remote-path; placeholder-text: "Folder inside share"; }
                    Button { text: "Connect"; clicked => { root.smb-connect-submitted(root.smb-server, root.smb-share, root.smb-username, root.smb-password, root.smb-remote-path); } }
                }
            }
        }

        if root.view-mode == 4 : VerticalBox {
            vertical-stretch: 1; spacing: 10px;
            HorizontalBox {
                height: 42px;
                Button { text: "Back"; clicked => { root.view-mode = 6; } }
                Text { text: "SMB Diagnostics"; horizontal-stretch: 1; font-size: 20px; font-weight: 700; color: #f2f2f7; vertical-alignment: center; horizontal-alignment: center; }
                Button { text: "Copy"; clicked => { root.copy-diagnostic-requested(); } }
            }
            ScrollView {
                vertical-stretch: 1; mouse-drag-pan-enabled: true;
                Text { text: root.diagnostic-report; wrap: word-wrap; font-family: "monospace"; color: #f2f2f7; }
            }
        }

        if root.view-mode == 0 : VerticalBox {
            vertical-stretch: 1; spacing: 0px;
            HorizontalBox {
                height: 44px; spacing: 8px; alignment: center;
                Text { text: "Notes"; horizontal-stretch: 1; font-size: 30px; font-weight: 700; color: #f2f2f7; vertical-alignment: center; }
                Button { text: "+"; width: 36px; height: 36px; horizontal-stretch: 0; enabled: root.workspace-open; clicked => { root.action-menu-root = true; root.action-menu-folder = false; root.action-menu-visible = true; root.action-name = ""; } }
                IconButton {
                    width: 36px;
                    height: 36px;
                    icon: @image-url("../resources/icon_preview_refresh.svg");
                    label: "Refresh Workspace";
                    enabled: root.workspace-open;
                    clicked => { root.refresh-requested(); }
                }
            }
            if root.action-menu-visible : Rectangle {
                height: root.action-menu-root ? 154px : (root.action-menu-folder ? 196px : 196px);
                background: #2c2c2e;
                border-radius: 9px;
                VerticalBox {
                    padding: 8px; spacing: 6px;
                    HorizontalBox {
                        height: 30px;
                        Text { text: root.action-menu-root ? "Create in workspace root" : "Item actions"; horizontal-stretch: 1; font-weight: 700; color: #f2f2f7; vertical-alignment: center; }
                        Button { text: "Cancel"; width: 74px; height: 30px; horizontal-stretch: 0; clicked => { root.action-menu-visible = false; } }
                    }
                    LineEdit { height: 38px; text <=> root.action-name; placeholder-text: root.action-menu-root ? "Name" : "New name"; }
                    HorizontalBox {
                        height: 38px; spacing: 6px;
                        Button { text: "New Note"; clicked => { if root.action-menu-root { root.new-note-root-requested(root.action-name); } else { root.new-note-requested(root.action-name); } } }
                        Button { text: "New Folder"; visible: root.action-menu-root || root.action-menu-folder; clicked => { if root.action-menu-root { root.new-folder-root-requested(root.action-name); } else { root.new-folder-requested(root.action-name); } } }
                    }
                    if !root.action-menu-root : HorizontalBox {
                        height: 38px; spacing: 6px;
                        Button { text: "Rename"; clicked => { root.rename-requested(root.action-name); } }
                        Button { text: "Delete"; clicked => { root.delete-requested(); } }
                    }
                }
            }
            VerticalBox {
                vertical-stretch: 1;
                LineEdit { height: 46px; text <=> root.search-query; placeholder-text: "Search notes"; edited => { root.search-requested(self.text); } }
                if root.search-query != "" : Text { height: 34px; text: "Search Results"; font-weight: 700; color: #f2f2f7; vertical-alignment: center; }
                if root.search-query != "" : ListView {
                    vertical-stretch: 1;
                    for result[index] in root.search-results : TreeRow {
                        text: result; activated => { root.search-result-selected(index); root.view-mode = 0; }
                    }
                }
                if root.search-query == "" : VerticalBox {
                    vertical-stretch: 1;
                    if !root.workspace-open : Button { text: "Choose Workspace"; clicked => { root.view-mode = 7; } }
                    ListView {
                        vertical-stretch: 1;
                        for label[index] in root.tree-labels : TreeRow {
                            text: label;
                            entry-kind: root.tree-entry-kinds[index];
                            depth: root.tree-entry-depths[index];
                            activated => { root.tree-selected(index); }
                            actions-requested => { root.tree-action-requested(index); root.action-menu-root = false; root.action-menu-folder = root.tree-entry-kinds[index] > 0; root.action-menu-visible = true; }
                        }
                    }
                }
            }
        }

        if root.view-mode == 1 : VerticalBox {
            vertical-stretch: 1; spacing: 8px;
            HorizontalBox {
                height: 44px; spacing: 8px; alignment: center;
                Button {
                    width: 36px;
                    height: 36px;
                    horizontal-stretch: 0;
                    text: "‹";
                    enabled: root.can-go-back;
                    clicked => { root.back-requested(); }
                }
                Text { text: root.current-path; horizontal-stretch: 1; font-weight: 700; color: #f2f2f7; overflow: elide; vertical-alignment: center; }
                IconButton {
                    width: 36px;
                    height: 36px;
                    icon: @image-url("../resources/icon_preview_keyboard_hide.svg");
                    label: "Hide Keyboard";
                    clicked => { root.smb-keyboard-dismiss-requested(); }
                }
                if !root.dirty : IconButton {
                    width: 36px;
                    height: 36px;
                    icon: @image-url("../resources/icon_preview_refresh.svg");
                    label: "Reload";
                    enabled: root.workspace-open;
                    clicked => { root.reload-requested(); }
                }
            }
            Flickable {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                interactive: true;
                viewport-height: root.editor-content-height;
                TextEdit {
                    width: parent.width;
                    height: root.editor-content-height;
                    text <=> root.editor-text;
                    edited => { root.editor-changed(self.text); }
                }
            }
            HorizontalBox {
                height: 42px;
                LineEdit { text <=> root.find-query; placeholder-text: "Find in note"; horizontal-stretch: 1; }
                Button { text: "Find"; clicked => { root.find-next-requested(root.find-query); } }
            }
        }

        if root.view-mode == 2 : MarkdownPreview {
            vertical-stretch: 1;
            show-document-title: true;
            document-title: root.current-path;
            mouse-drag-pan-enabled: true;
            block-spacing: 10px;
            block-texts: root.preview-block-texts;
            block-plain-texts: root.preview-block-plain-texts;
            block-kinds: root.preview-block-kinds;
            heading-levels: root.preview-heading-levels;
            task-checked: root.preview-task-checked;
            task-offsets: root.preview-task-offsets;
            mermaid-images: root.preview-block-mermaid-images;
            mermaid-errors: root.preview-block-mermaid-errors;
            images: root.preview-block-images;
            link-clicked(link) => { root.preview-link-clicked(link); }
            task-toggled(offset) => { root.preview-task-toggled(offset); }
        }

        Text { text: root.status; color: root.external-conflict ? #a22b2b : #6c6c70; wrap: word-wrap; max-height: 38px; }
        HorizontalBox {
            height: 50px; spacing: 6px;
            Button { text: "Notes"; horizontal-stretch: 1; clicked => { root.view-mode = 0; } }
            Button { text: "Edit"; enabled: root.workspace-open; horizontal-stretch: 1; clicked => { root.view-mode = 1; } }
            Button { text: "Preview"; enabled: root.workspace-open; horizontal-stretch: 1; clicked => { root.view-mode = 2; } }
            IconButton {
                icon: @image-url("../resources/icon_preview_settings.svg");
                label: "Settings";
                clicked => { root.view-mode = 6; }
            }
        }
    }
}
